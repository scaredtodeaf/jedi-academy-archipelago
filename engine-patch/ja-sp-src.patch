+// Archipelago: the prologue (character creation through the end of the
+// training sequence) is intentionally left as vanilla, ungated progression -
+// see the matching map list and rationale in AP_IsMissionMapLocked (server/
+// sv_ccmds.cpp). Kept as a separate small list here rather than shared code
+// since this is engine-side (server/) vs game-side (game/) and the two
+// modules don't share source.
+static qboolean AP_IsPrologueMap( const char *mapname )
+{
+	// Confirmed from a live server log (2026-08-20): the real campaign opens
+	// on yavin1 -> yavin1b -> (presumably yavin2), not academy1-6 - those
+	// don't appear anywhere in objectives.h's objective table, so they're
+	// not part of the actual SP campaign flow at all. t1_sour/t1_inter kept -
+	// both have real entries in that table (T1_SOUR_OBJ1-4) and bridge into
+	// the holomap.
+	static const char *prologueMaps[] = {
+		"yavin1", "yavin1b", "yavin2",
+		"t1_sour", "t1_inter",
+	};
+	for ( size_t i = 0; i < ARRAY_LEN( prologueMaps ); i++ )
+	{
+		if ( !Q_stricmp( mapname, prologueMaps[i] ) )
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
