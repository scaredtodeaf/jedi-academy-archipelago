+// Archipelago: polls a command queue file the AP client writes to. This SP
+// build has no rcon support at all (confirmed - nothing in code/server/
+// implements it, unlike MP/dedicated), so this is the substitute: the client
+// appends lines like "set g_apUnlock_t1_danger 1" or "ap_setForcePush 2" to
+// ap_commands.txt (fs_homepath, same place openjk_sp.cfg/qconsole.log live),
+// we poll and execute each line as a real console command, then clear the
+// file. Read-direction (check detection) needs no code at all - the engine's
+// built-in "logfile 2" cvar already mirrors every console print, including
+// our "Archipelago: ... check reached" lines, straight to qconsole.log.
+static int s_apNextCommandPollTime = 0;
+static void AP_PollCommandQueue( void )
+{
+	if ( level.time < s_apNextCommandPollTime )
+	{
+		return;
+	}
+	s_apNextCommandPollTime = level.time + 500;
+
+	fileHandle_t f;
+	int len = gi.FS_FOpenFile( "ap_commands.txt", &f, FS_READ );
+	if ( len <= 0 )
+	{
+		if ( f )
+		{
+			gi.FS_FCloseFile( f );
+		}
+		return;
+	}
+
+	static char buffer[8192];
+	if ( len >= (int)sizeof(buffer) )
+	{
+		len = sizeof(buffer) - 1;
+	}
+	gi.FS_Read( buffer, len, f );
+	buffer[len] = '\0';
+	gi.FS_FCloseFile( f );
+
+	char *line = strtok( buffer, "\r\n" );
+	while ( line )
+	{
+		if ( *line )
+		{
+			gi.SendConsoleCommand( va( "%s\n", line ) );
+		}
+		line = strtok( NULL, "\r\n" );
+	}
+
+	// clear the queue now that it's been consumed
+	fileHandle_t fw;
+	gi.FS_FOpenFile( "ap_commands.txt", &fw, FS_WRITE );
+	if ( fw )
+	{
+		gi.FS_FCloseFile( fw );
+	}
+}
