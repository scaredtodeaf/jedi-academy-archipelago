 //=========================================================
+// Archipelago: mission-tier holomap gating.
+//
+// Only the 14 non-linear holomap mission-select entry points are lock-checked
+// here - the prologue (academy1-6, t1_sour, t1_inter) and the fixed
+// post-holomap endgame chain (hoth2/3, kor1/2, taspir1/2, vjun1-3, yavin1/1b/2)
+// are vanilla linear progression the player can't choose between, so they're
+// intentionally left ungated. This is the single choke point every map load
+// in the SP game passes through (console "map"/"devmap", and the mission
+// select menu's "maptransition" command both funnel into SV_Map_()), so
+// blocking here is authoritative - not just a UI-side grey-out.
+static const char *s_apGatedMissionMaps[] = {
+	"t1_danger", "t1_fatal", "t1_rail", "t1_surprise",
+	"t2_dpred", "t2_rancor", "t2_rogue", "t2_trip", "t2_wedge",
+	"t3_bounty", "t3_byss", "t3_hevil", "t3_rift", "t3_stamp",
+};
+
+static bool AP_IsMissionMapLocked( const char *map )
+{
+	for ( size_t i = 0; i < ARRAY_LEN( s_apGatedMissionMaps ); i++ )
+	{
+		if ( !Q_stricmp( map, s_apGatedMissionMaps[i] ) )
+		{
+			char cvarName[64];
+			Com_sprintf( cvarName, sizeof(cvarName), "g_apUnlock_%s", map );
+			return Cvar_VariableIntegerValue( cvarName ) == 0;
+		}
+	}
+	return false; // not a gated mission map, never locked
+}
